generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── CORE (Phase 1) ──────────────────────────────────────────────────────────

model Organization {
  id                      String    @id @default(cuid())
  clerkOrgId              String    @unique
  name                    String
  slug                    String?   @unique
  squareCustomerId        String?
  squareSubscriptionId    String?
  subscriptionStatus      String?   @default("inactive")
  activeModules           String[]  @default([])
  squareAccessToken       String?
  squareRefreshToken      String?
  squareTokenExpiresAt    DateTime?
  lastCatalogSyncAt       DateTime?
  instagramAccessToken    String?
  instagramTokenExpiresAt DateTime?
  instagramUserId         String?
  instagramUsername       String?
  instagramEnabled        Boolean   @default(false)
  instagramConnectedAt    DateTime?
  // Days an unacknowledged handoff note keeps surfacing past its target day.
  handoffNoteExpireDays   Int       @default(2)
  // HR-11b: governs inline `Date:` field stamps ONLY ("dateOnly" | "dateTime").
  // Validation stamps and the Certificate of Acknowledgment always render full
  // date+time regardless (court-defensibility, per DECISIONS F5b).
  hrDateStampFormat       String    @default("dateOnly")
  createdAt               DateTime  @default(now())

  stores                        Store[]
  users                         User[]
  pendingInvites                PendingInvite[]
  staff                         StaffMember[]
  templates                     Template[]
  templateTypes                 TemplateType[]
  checklists                    Checklist[]
  storageAreas                  StorageArea[]
  inventoryCounts               InventoryCount[]
  itemMetadata                  ItemMetadata[]
  menuItems                     MenuItem[]
  auditLogs                     AuditLog[]
  catalogCategories             CatalogCategory[]
  catalogItems                  CatalogItem[]
  vendors                       Vendor[]
  purchaseOrders                PurchaseOrder[]
  squareCategories              SquareCategory[]
  salesItems                    SalesItem[]
  ingredientCategories          IngredientCategory[]
  ingredients                   Ingredient[]
  ingredientDuplicateDismissals IngredientDuplicateDismissal[]
  salesPeriodCaches             SalesPeriodCache[]
  salesLineCaches               SalesLineCache[]
  salesHourlyCaches             SalesHourlyCache[]
  storeMonthlyGoals             StoreMonthlyGoal[]
  goalPlans                     GoalPlan[]
  recipes                       Recipe[]
  inventoryAdjustments          InventoryAdjustment[]
  adjustmentGroups              AdjustmentGroup[]
  lossReasons                   LossReason[]
  varianceAdjustments           VarianceAdjustment[]
  storeIngredientPars           StoreIngredientPar[]
  teamMessages                  TeamMessage[]
  corporateUpdates              CorporateUpdate[]
  paceAlertLogs                 PaceAlertLog[]
  hrDocuments                   HrDocument[]
  managerNotes                  ManagerNote[]
  trainingModules               TrainingModule[]
  staffDocuments                StaffDocument[]
  laborPositions                LaborPosition[]
  laborSettings                 LaborSettings[]
  salesForecasts                SalesForecast[]
  laborDaySplits                LaborDaySplit[]
  laborDayparts                 LaborDaypart[]
  laborDayAdjustments           LaborDayAdjustment[]
  weeklyDayHours                WeeklyDayHours[]
}

model User {
  id             String   @id @default(cuid())
  clerkUserId    String   @unique
  organizationId String
  email          String
  name           String?
  role           Role     @default(STAFF)
  // BUILD-2: the store this user lands on. Lives on User, not on
  // StoreUserAssignment, because ADMINs have NO assignment rows at all (every
  // page scopes with `...(isAdmin ? {} : { id: { in: storeIds } })`) — and the
  // PERM-7 device account is exactly the case that most needs a default.
  // Nullable with no backfill: null = fall back to alphabetically-first, which
  // is what every picker already does. Validated on write AND on read, since
  // assignments churn (Clerk webhook, admin edit) after a default is set.
  defaultStoreId String?
  // PERM-5: capabilities SUBTRACTED from this user's role baseline. Empty (the
  // default for every existing row) = pure role baseline. Never additive — see
  // can() in src/lib/permissions.ts: the ceiling check returns before this list
  // is read, so an entry here can only turn true into false.
  //
  // Survives same-Clerk-account membership churn. The organizationMembership
  // .created upsert takes its UPDATE branch for a returning clerkUserId and
  // that branch writes `email` only (api/webhooks/clerk/route.ts), so remove-
  // and-re-add preserves this column. It is lost only when the person arrives
  // on a NEW clerkUserId — which restricted mode (production, ON since
  // 2026-08-04) makes an admin-visible event rather than a silent duplicate.
  deniedCapabilities String[]
  createdAt      DateTime @default(now())

  organization         Organization          @relation(fields: [organizationId], references: [id])
  defaultStore         Store?                @relation("UserDefaultStore", fields: [defaultStoreId], references: [id], onDelete: SetNull)
  storeAssignments     StoreUserAssignment[]
  taskLogs             TaskLog[]
  teamMessages         TeamMessage[]         @relation("TeamMessageAuthor")
  resolvedMessages     TeamMessage[]         @relation("TeamMessageResolver")
  acknowledgedMessages TeamMessage[]         @relation("TeamMessageAcknowledger")
  messageReactions     MessageReaction[]
  messageReads         MessageRead[]
  corporateUpdates     CorporateUpdate[]
  staffMember          StaffMember?
}

model Store {
  id               String   @id @default(cuid())
  organizationId   String
  squareLocationId String?  @unique
  storeNumber      String?
  name             String
  brand            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  timezone         String   @default("America/Los_Angeles")
  contactEmail     String?
  phoneNumber      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  organization              Organization                    @relation(fields: [organizationId], references: [id])
  hours                     StoreHours[]
  userAssignments           StoreUserAssignment[]
  staffAssignments          StoreStaffAssignment[]
  // BUILD-2 back-relation for User.defaultStoreId. onDelete: SetNull lives on
  // the User side — deleting a store clears the default, it does not cascade
  // into user rows.
  defaultForUsers           User[]                          @relation("UserDefaultStore")
  templateAssignments       TemplateStoreAssignment[]
  checklists                Checklist[]
  storageAreas              StorageArea[]
  inventoryCounts           InventoryCount[]
  purchaseOrders            PurchaseOrder[]
  salesPeriodCaches         SalesPeriodCache[]
  salesLineCaches           SalesLineCache[]
  salesHourlyCaches         SalesHourlyCache[]
  monthlyGoals              StoreMonthlyGoal[]
  goalPlans                 GoalPlan[]
  dailyGoals                DailyGoal[]
  inventoryAdjustments      InventoryAdjustment[]
  adjustmentGroupsFrom      AdjustmentGroup[]               @relation("AdjustmentGroupFromStore")
  adjustmentGroupsTo        AdjustmentGroup[]               @relation("AdjustmentGroupToStore")
  varianceAdjustments       VarianceAdjustment[]
  ingredientPars            StoreIngredientPar[]
  teamMessages              TeamMessage[]
  paceAlertLogs             PaceAlertLog[]
  hrDocumentAssignments     HrDocumentStoreAssignment[]
  trainingModuleAssignments TrainingModuleStoreAssignment[]
  laborSettings             LaborSettings[]
  salesForecasts            SalesForecast[]
  laborDaySplits            LaborDaySplit[]
  laborDayparts             LaborDaypart[]
  laborDayAdjustments       LaborDayAdjustment[]
  weeklyDayHours            WeeklyDayHours[]
}

// CHK-2 (S2) gave this table its first writer; CHK-3 (S3) gives it the key that
// writer had to work around. THERE WAS NO @@unique([storeId, dayOfWeek]) from
// 20260627002005_init until 2026-08-09, so the table could hold two rows for one
// weekday and BOTH readers resolved that with `.find()` — whichever row came
// back first won, silently. That is why api/stores/[id]/hours/route.ts replaces
// the whole week inside a transaction rather than upserting: there was no key to
// target. The replace stays correct with the constraint in place; the
// constraint additionally makes the duplicate unrepresentable.
//
// ONE-SIDED AND OVERNIGHT ROWS ARE LEGAL HERE AND ALWAYS WERE — both times are
// independently nullable and no ordering check exists, deliberately (a store
// that closes at 02:00 is a real store). What the two readers DO with such a row
// is where they disagree; see the hours block in src/lib/checklist-lifecycle.ts,
// which is the single site that documents it, and DEBT-64.
model StoreHours {
  id          String  @id @default(cuid())
  storeId     String
  dayOfWeek   Int
  openingTime String?
  closingTime String?
  isClosed    Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
}

model StoreUserAssignment {
  id      String @id @default(cuid())
  userId  String
  storeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

model PendingInvite {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           Role
  storeIds       String[] @default([])
  // HR-7: set when the invite is a staff self-service invite — the Clerk
  // webhook links the new User to this StaffMember on acceptance. Plain id
  // (no FK) so the invite row never blocks staff lifecycle changes.
  staffMemberId  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

model StaffMember {
  id                 String    @id @default(cuid())
  organizationId     String
  // Per-ORG unique, not global: the same real Square employee can be imported
  // by more than one tenant (Froot connects tenants to the same Square
  // account in some setups). NULLs stay distinct, so manual members (no
  // Square id) never collide.
  squareTeamMemberId String?
  // displayName = OPERATIONAL identity (rosters, checklists, messages). Casual,
  // Froot-native — Square seeds it once at import and resync never overwrites it.
  displayName        String
  // fullName = LEGAL identity. The only name that lands on signed documents and
  // the Certificate of Acknowledgment. When fullNameLocked, it is Froot-confirmed
  // and a Square resync must not clobber it. squareFullName tracks the last
  // given+family seen from Square to surface a lock/Square divergence (never the
  // legal name shown anywhere).
  fullName           String?
  fullNameLocked     Boolean   @default(false)
  squareFullName     String?
  email              String?
  // HR-7 rule 1/2: offboarding sets TERMINATED (never deletes) — Square
  // INACTIVE reconcile and the manager terminate action both land here, and
  // every /my/* read requires ACTIVE server-side.
  status             String    @default("ACTIVE") // ACTIVE | TERMINATED
  terminatedAt       DateTime?
  // Nullable link to a Clerk-backed login (HR-7 invite flow). Most staff
  // never get one; termination revokes the Clerk side but the link remains
  // governed by the organizationMembership.deleted webhook.
  userId             String?   @unique
  // HR-15 Policy B (re-sign on rehire): each tenure is a signing cycle.
  // Reactivation bumps the cycle and stamps rehiredAt; acknowledgment and
  // signed-record rows carry the cycle they were signed under, and only
  // current-cycle signatures count toward compliance. Prior cycles stay
  // untouched and auditable.
  signingCycle       Int       @default(1)
  rehiredAt          DateTime?
  // DEBT-9: this person's work location is the COMPANY, not a store. Square has
  // no concept of a primary or master location — corporate staff are
  // ALL_CURRENT_AND_FUTURE_LOCATIONS, so the sync expands them to one
  // StoreStaffAssignment per store with nothing to derive a home from
  // (square.ts:265-268). primaryStoreName() would then stamp whichever store
  // sorts first alphabetically into a signed legal record. A boolean, not a
  // label: five of the six consumers need a predicate ("which bucket?",
  // "exclude?", "suppress the warning?"), and only primaryStoreName() needs the
  // string, which is the CORPORATE_STORE_LABEL constant in lib/hr.ts.
  //
  // NOT a synthetic "Corporate" Store row (Gary, 2026-08-02): Store rows are
  // Square-linked, and a fake one leaks into every store picker, forecast,
  // coverage calculation, checklist scope, roster and the /staff grouping.
  //
  // false — the default, and every pre-existing row — means "homed at a store",
  // which is the behaviour everyone has today.
  isCorporate        Boolean   @default(false)
  createdAt          DateTime  @default(now())

  organization        Organization             @relation(fields: [organizationId], references: [id])
  user                User?                    @relation(fields: [userId], references: [id])
  storeAssignments    StoreStaffAssignment[]
  taskLogs            TaskLog[]
  teamMessages        TeamMessage[]
  managerNotes        ManagerNote[]
  formSubmissions     FormSubmission[]
  trainingAssignments TrainingAssignment[]
  lessonCompletions   TrainingLessonProgress[]
  signedRecords       HrSignedRecord[]
  uploadedDocuments   StaffDocument[]

  @@unique([organizationId, squareTeamMemberId])
}

model StoreStaffAssignment {
  id            String  @id @default(cuid())
  staffMemberId String
  storeId       String
  isPrimary     Boolean @default(false)

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, storeId])
}

model Template {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  // TPL-2 steps (1) and (2), 2026-08-08 — THE CONTRACT ON THIS COLUMN CHANGED.
  // It was previously written on every path and read by every site; the note
  // that stood here said "never write one without the other". That is no
  // longer the rule.
  //
  // `type` is the LEGACY free-text column and NOTHING READS IT while typeId is
  // set. Every read site resolves the name through the templateType relation
  // and falls back to this string only for a row whose typeId is null.
  //
  // It is still written by the TWO CREATE PATHS ONLY — POST /api/templates and
  // POST /api/templates/import — for one reason: String NOT NULL with no
  // default, so a create that omits it fails. PATCH /api/templates/[id], the
  // rename cascade in PATCH /api/template-types/[id] and
  // POST /api/template-types/[id]/reassign all STOPPED writing it. So on a row
  // whose type was later renamed or reassigned, this column holds a STALE NAME
  // BY DESIGN. Do not read it, and do not repair a divergence you find.
  //
  // Retiring the column is TPL-2 step (3): a DESTRUCTIVE migration against
  // production, gated on its own soak, EXPLICITLY NOT AUTHORISED by the row
  // that made this change. Plan: docs/prompts/TPL-2_PLAN.md.
  type             String
  typeId           String?
  frequency        String   @default("Daily")
  availabilityType String   @default("StoreHours")
  operationalPhase String?
  startOffsetHours Int?
  endOffsetHours   Int?
  isActive         Boolean  @default(true)
  isArchived       Boolean  @default(false)
  appliesTo        String   @default("all")
  createdAt        DateTime @default(now())

  organization     Organization              @relation(fields: [organizationId], references: [id])
  templateType     TemplateType?             @relation(fields: [typeId], references: [id])
  storeAssignments TemplateStoreAssignment[]
  tasks            Task[]
  sections         Section[]
  checklists       Checklist[]
  handoffMessages  TeamMessage[]             @relation("HandoffTarget")

  @@index([typeId])
}

// TPL-1a. Per-org template taxonomy — the third instance of the house pattern
// set by IngredientCategory and LossReason: @@unique([organizationId, name]),
// sortOrder, org-scoped. Operators create and colour these; nothing here is a
// global list.
//
// colorKey IS A KEY, NOT A CLASS STRING. Tailwind 4 runs CSS-first in this repo
// (globals.css:1, no tailwind.config.*, no safelist) and generates utilities by
// scanning source text, so a class string stored in this column would never be
// generated and the badge would render unstyled. The key maps to a literal
// class string in src/lib/badge-presets.ts. See docs/prompts/TYPE-1_AUDIT.md §7
// — this is a build-system constraint, not a style preference.
model TemplateType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  colorKey       String   @default("gray")
  sortOrder      Int      @default(0)
  // TPL-1b, 2026-08-08: `active` HAS NO WRITER. It shipped in TPL-1a and the
  // manage dialog deliberately does not expose a deactivate control (Gary, Q2)
  // — the ruled model is delete-or-keep, with reassignment in front of delete,
  // and a third state nobody asked for would just be a second way to hide a
  // type. GET /api/template-types still filters on it, so it is a working
  // read-side filter waiting for a writer, not dead code. Left rather than
  // dropped: removing it is a schema change and the retirement of the legacy
  // Template.type column (TPL-2) is the right moment to revisit it.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  templates    Template[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TemplateStoreAssignment {
  id         String @id @default(cuid())
  templateId String
  storeId    String

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([templateId, storeId])
}

// CHK-1. Sections become first-class, PER TEMPLATE — the TemplateType precedent
// where it fits and not where it does not. TemplateType is per-ORG with its own
// management dialog because a type is a taxonomy shared across templates. A
// section is a heading INSIDE one template: it has no meaning outside it, two
// templates may both have "Restocking" and they are not the same thing, and it
// is edited where it is used. So this model takes TPL-1's @@unique-on-name,
// sortOrder and @@index conventions, and takes NO management surface.
model Section {
  id         String   @id @default(cuid())
  templateId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  template Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    Task[]
  // A TaskLog points at the section its task belonged to, so the FK is RESTRICT
  // in both directions: a section that any historical log references cannot be
  // deleted, which is what keeps the as-executed record resolvable.
  taskLogs TaskLog[]

  @@unique([templateId, name])
  @@index([templateId])
}

model Task {
  id                   String   @id @default(cuid())
  templateId           String
  // SECTION RENAMES REWRITE HISTORY, AND THAT IS A COMPLIANCE FACT, NOT A
  // DESIGN PREFERENCE. Relocated here from DEBT-36 2026-08-02 by DEBT-TRIAGE-2.
  // A section is not an entity — it is a free-text string GROUPed over,
  // recomputed independently at five render sites — so there is no canonical
  // list, no rename operation, and no stable id. Checklist does not snapshot
  // task data (api/checklists/route.ts:122 and :156 store only ids) and TaskLog
  // carries no section column (see that model below). THERE IS NO AS-EXECUTED
  // RECORD OF SECTION NAMES ANYWHERE IN THE SYSTEM: renaming a section
  // retroactively rewrites the headings on every historical completed checklist
  // AND its print copy, with no indication anything changed. A printed closing
  // checklist from last month re-prints today under whatever the section is
  // called today. For an operational-compliance product that is the part that
  // matters. Whether to model Section as a first-class entity is AWAITING
  // GARY'S RULING on DEBT-36 — this comment records the fact, not the decision.
  //
  // CHK-1 (S1), 2026-08-09 — RULED AND BUILT. The block above records what was
  // true before this row and is left unedited. What changed: `sectionId` below
  // is the entity, and `sectionName` IS NOW A LEGACY MIRROR — kept, and kept
  // written alongside `sectionId` on every write path, exactly TPL-1a's shape.
  // Read the JOIN, not this string; it is the fallback for a row whose
  // `sectionId` is null (nothing after the CHK-1 backfill should be, and the
  // verification query in docs/prompts/CHK-1_PLAN.md §2.1 is what proves it).
  // Retiring the column is a LATER ROW and is not CHK-1's business.
  // The as-executed half of the defect above is answered by
  // `Checklist.sectionsSnapshot`, not by this column.
  sectionName          String
  sectionId            String?
  description          String
  estimatedTimeMinutes Float?
  requiresPhoto        Boolean  @default(false)
  requiresTemp         Boolean  @default(false)
  isCritical           Boolean  @default(false)
  orderIndex           Int      @default(0)
  excludedStoreIds     String[]
  videoUrl             String?

  template   Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section    Section?        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  taskLogs   TaskLog[]
  attachment TaskAttachment?

  @@index([sectionId])
}

model TaskAttachment {
  id          String   @id @default(cuid())
  taskId      String   @unique
  label       String
  url         String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Checklist {
  id             String    @id @default(cuid())
  organizationId String
  templateId     String
  storeId        String
  date           DateTime
  status         String    @default("Pending")
  startedAt      DateTime?
  completedAt    DateTime?
  completionRate Float?    @default(0)

  // CHK-1. The as-executed record DEBT-36 says does not exist. Frozen ONCE —
  // on the first TaskLog write, or at day close for a checklist never started
  // — and NEVER rewritten. Shape: [{ "sectionId": "...", "name": "...",
  // "sortOrder": 0 }]. Print and history render headings from here when
  // present and fall back to the live join when null (rows completed before
  // this migration). Deliberately does NOT freeze task descriptions — see
  // docs/prompts/CHK-1_PLAN.md §2.4.
  //
  // S1 SCOPE NOTE, appended 2026-08-09 rather than editing the block above:
  // S1 ships ONLY the first-TaskLog freeze
  // (api/checklists/[id]/task-log/route.ts). The "or at day close" half needs
  // the day-close cron, which is CHK-3 — so a checklist nobody ever started
  // has a null snapshot today, and renders live. src/lib/sections.ts is the
  // single reader.
  //
  // S3 CORRECTION, appended 2026-08-09 — THE "OR AT DAY CLOSE" HALF IS NOT
  // BUILT, AND IT IS NOT DEFERRED EITHER; IT IS RULED OUT. CHK-3's day-close job
  // materialises a Missed row for a checklist nobody started and leaves
  // `sectionsSnapshot` NULL on it, per its own session prompt ("a materialized
  // row has no task logs and no snapshot"). The reason is this column's own
  // reason: it is the AS-EXECUTED record, and a checklist nobody touched has no
  // as-executed headings. Freezing today's names onto it would make a guess
  // indistinguishable from a record — plan §12.5's ruling on historical TaskLog
  // rows, one row-type further on. A materialised row therefore renders live
  // through src/lib/sections.ts, exactly like a pre-CHK-1 row.
  sectionsSnapshot Json?

  // ─── CHK-3 (S3) lifecycle ──────────────────────────────────────────────────
  // Four columns, and the division between them is the point.
  //
  // OVERDUE IS NOT HERE. It is derived on read from the expected window and
  // "now" (src/lib/checklist-lifecycle.ts) — a live nagging state, correct the
  // instant an offset changes, with nothing to keep in sync. MISSED IS a stored
  // status, because Gary's R1 makes it a closed fact and a fact needs a writer.
  // The writer is GET /api/cron/checklist-day-close, and it is the only one.
  //
  // NO BACKFILL. Every row that existed before Migration B keeps closedAt NULL,
  // completedLate false and both expectations NULL, and that is correct rather
  // than lazy: no expected window existed before this phase, so no historical
  // row can be said to have met or missed one. The lifecycle starts at deploy
  // and the operations report says so on its face (plan §7).
  closedAt        DateTime? // day-close instant; written once, by the cron
  completedLate   Boolean   @default(false) // written by submit, when completedAt > expectedEndAt
  // The window this row was judged against, FROZEN AT MATERIALISATION — at
  // create for a checklist somebody started, at day close for one the cron
  // materialised — so a later offset edit cannot retroactively make a past miss
  // look on-time. NULL means no expectation was ever recorded (blank offsets,
  // AllDay, no store hours, or a row predating Migration B); it never means
  // "on time".
  expectedStartAt DateTime?
  expectedEndAt   DateTime?

  organization    Organization  @relation(fields: [organizationId], references: [id])
  template        Template      @relation(fields: [templateId], references: [id])
  store           Store         @relation(fields: [storeId], references: [id])
  taskLogs        TaskLog[]
  handoffMessages TeamMessage[] @relation("HandoffSource")

  // The day-close job scans by (storeId, date); the operations report asks
  // "missed, by day, across the org". Without these the hourly cron is a seq
  // scan of the whole table, forever.
  @@unique([storeId, templateId, date])
  @@index([storeId, date])
  @@index([organizationId, date, status])
}

// NOTE THE ABSENCE: there is no section column here, and that is the other half
// of the compliance fact recorded on Task.sectionName above (DEBT-36, relocated
// 2026-08-02 by DEBT-TRIAGE-2). A TaskLog is the as-executed record of a task
// being completed — it carries who, when, the photo and the temperature — but
// it does NOT capture the section heading the task was executed under. That
// heading is resolved live from Task.sectionName at render and at print time,
// so it is whatever the template says TODAY, not what it said on the day the
// work was done. Adding a column here is one candidate fix and is deliberately
// NOT proposed as the answer; DEBT-36 is awaiting Gary's ruling on whether
// Section becomes a first-class entity instead.
//
// CHK-1 (S1), 2026-08-09 — RULED, AND THE ABSENCE IS PARTLY FILLED. Gary took
// the entity direction, so `sectionId` below now exists. READ WHAT IT IS AND
// WHAT IT IS NOT: it is the id of the section the task belongs to, an
// identifier — NOT a name, and NOT an as-executed record on its own. There is
// deliberately no name column here (DEBT-26's discipline: one place per fact).
// The as-executed NAME lives on `Checklist.sectionsSnapshot`, frozen once at
// first task log.
// Rows written BEFORE the CHK-1 migration had their `sectionId` backfilled
// from the task's section AS IT STANDS TODAY, and NO NAME WAS FABRICATED for
// them (Gary, 2026-08-09, plan §12.5). A historical log's heading is
// unknowable; writing today's name into it would make a guess indistinguishable
// from a record, which is the exact defect DEBT-36 is about. The as-executed
// record starts at deploy.
model TaskLog {
  id                 String   @id @default(cuid())
  checklistId        String
  taskId             String
  sectionId          String?
  completedByUserId  String?
  completedByStaffId String?
  completedAt        DateTime @default(now())
  photoUrl           String?
  temperatureValue   Float?
  notes              String?

  checklist        Checklist    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  task             Task         @relation(fields: [taskId], references: [id])
  section          Section?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  completedByUser  User?        @relation(fields: [completedByUserId], references: [id])
  completedByStaff StaffMember? @relation(fields: [completedByStaffId], references: [id])

  @@index([sectionId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, entityType, createdAt])
}

// ─── PHASE F-5: BEHIND-PACE ALERTS ───────────────────────────────────────────
// One row per store-month = the alert was sent; its unique constraint is the
// idempotency lock that keeps the daily cron from re-alerting all month.
model PaceAlertLog {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  month          DateTime @db.Date // first-of-month UTC date
  pacePct        Float
  thresholdPct   Float
  recipients     String[]
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, month])
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  STORE
}

// ─── PHASE 2: INVENTORY MODULE ────────────────────────────────────────────────

model StorageArea {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization       Organization               @relation(fields: [organizationId], references: [id])
  store              Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredientMappings IngredientStorageMapping[]
  countLines         InventoryCountLine[]
}

// Per-store assignment of an ingredient to a storage area. An ingredient may map
// into multiple areas of the same store; sortOrder is the shelf-to-sheet count order.
model IngredientStorageMapping {
  id            String @id @default(cuid())
  storageAreaId String
  ingredientId  String
  sortOrder     Int    @default(0)

  storageArea StorageArea @relation(fields: [storageAreaId], references: [id], onDelete: Cascade)
  ingredient  Ingredient  @relation(fields: [ingredientId], references: [id])

  @@unique([storageAreaId, ingredientId])
}

model ItemMetadata {
  id                 String   @id @default(cuid())
  organizationId     String
  squareCatalogObjId String
  vendorName         String?
  vendorId           String?
  glCode             String?
  parLevel           Float?
  unitCostOverride   Float?
  unitOfMeasure      String?
  notes              String?
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  @@unique([organizationId, squareCatalogObjId])
}

model CatalogCategory {
  id               String  @id @default(cuid())
  organizationId   String
  squareCategoryId String
  name             String
  isDeleted        Boolean @default(false)
  sortOrder        Int     @default(0)

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        CatalogItem[]

  @@unique([organizationId, squareCategoryId])
}

model CatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  squareItemId   String?
  categoryId     String?
  name           String
  description    String?
  isDeleted      Boolean  @default(false)
  isArchived     Boolean  @default(false)
  productType    String?
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  category     CatalogCategory?       @relation(fields: [categoryId], references: [id])
  variations   CatalogItemVariation[]

  @@unique([organizationId, squareItemId])
}

model CatalogItemVariation {
  id                String  @id @default(cuid())
  catalogItemId     String
  squareVariationId String?
  name              String
  sku               String?
  priceMoney        Int?
  ordinal           Int     @default(0)

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([catalogItemId, squareVariationId])
}

model Vendor {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  accountNumber   String?
  contactName     String?
  email           String?
  phone           String?
  terms           String?
  leadTimeDays    Int?
  // I-7: minimum-order thresholds — cart review warns (never blocks) when a
  // draft PO for this vendor is under either one.
  minOrderCases   Float?
  minOrderDollars Float?
  // I-7: weekday ints 0 (Sun) – 6 (Sat); new POs default expectedAt to the
  // next configured delivery day (falling back to leadTimeDays, then next
  // weekday).
  deliveryDays    Json?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id])
  vendorIngredients VendorIngredient[]
  purchaseOrders    PurchaseOrder[]
  itemMetadata      ItemMetadata[]
  adjustments       VendorAdjustment[]
}

// I-7: standing invoice-level adjustments (fuel surcharge, bottle deposits,
// credits...) auto-attached as editable lines when receiving this vendor's
// POs. glCode keeps the whole invoice categorizable for finance.
model VendorAdjustment {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  type      String // FLAT | PERCENT (of the PO's line total)
  value     Float // dollars for FLAT, percent points for PERCENT (5 = 5%)
  glCode    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  vendor        Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  poAdjustments PurchaseOrderAdjustment[]
}

// I-7: adjustment line attached to a specific PO at receive time — a snapshot
// of (or manual addition beyond) the vendor's standing adjustments. amount is
// the resolved dollar effect on this PO; included in COGS GL breakdowns.
model PurchaseOrderAdjustment {
  id                 String   @id @default(cuid())
  purchaseOrderId    String
  vendorAdjustmentId String?
  name               String
  type               String // FLAT | PERCENT
  value              Float
  amount             Float
  glCode             String?
  createdAt          DateTime @default(now())

  purchaseOrder    PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendorAdjustment VendorAdjustment? @relation(fields: [vendorAdjustmentId], references: [id])
}

model VendorIngredient {
  id              String  @id @default(cuid())
  vendorId        String
  ingredientId    String
  vendorSku       String?
  packDescription String?
  casePrice       Float?
  unitsPerCase    Float?

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([vendorId, ingredientId])
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  organizationId  String
  storeId         String
  vendorId        String
  poNumber        String
  invoiceNumber   String?
  orderedAt       DateTime?
  expectedAt      DateTime?
  totalAmount     Float     @default(0)
  status          String    @default("DRAFT")
  enteredByUserId String?
  receivedAt      DateTime? // set when the PO reaches RECEIVED (fully received)
  invoiceFileUrl  String? // I-7: invoice photo/PDF attached at receiving (Vercel Blob)
  createdAt       DateTime  @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id])
  store        Store                     @relation(fields: [storeId], references: [id])
  vendor       Vendor                    @relation(fields: [vendorId], references: [id])
  lines        PurchaseOrderLine[]
  adjustments  PurchaseOrderAdjustment[]

  @@unique([organizationId, poNumber])
}

model PurchaseOrderLine {
  id               String    @id @default(cuid())
  purchaseOrderId  String
  ingredientId     String
  ingredientName   String
  quantityOrdered  Float
  quantityReceived Float     @default(0)
  unitCost         Float
  lineTotal        Float
  receivingNote    String?
  receivedAt       DateTime? // last receipt timestamp — places the received value in an inventory period

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])
}

// ─── PHASE 2: INVENTORY MODULE v2 — sales items (Square) vs ingredients (Froot) ──

model SquareCategory {
  id               String  @id @default(cuid())
  organizationId   String
  squareCategoryId String
  name             String
  isDeleted        Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  salesItems   SalesItem[]

  @@unique([organizationId, squareCategoryId])
}

model SalesItem {
  id                String   @id @default(cuid())
  organizationId    String
  squareItemId      String
  squareVariationId String
  name              String
  variationName     String
  displayName       String
  squareCategoryId  String?
  menuGroup         String?
  priceCents        Int?
  isDeleted         Boolean  @default(false)
  recipeStatus      String   @default("UNMAPPED") // UNMAPPED | MAPPED | NON_RECIPE
  updatedAt         DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  squareCategory      SquareCategory?      @relation(fields: [squareCategoryId], references: [id])
  recipe              Recipe?
  varianceAdjustments VarianceAdjustment[]

  @@unique([organizationId, squareVariationId])
}

model IngredientCategory {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  glCode         String?
  sortOrder      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  ingredients  Ingredient[]

  @@unique([organizationId, name])
}

model Ingredient {
  id                   String    @id @default(cuid())
  organizationId       String
  brand                String?
  name                 String
  categoryId           String?
  subcategory          String?
  sku                  String?
  purchaseUnitLabel    String
  packDescription      String?
  purchaseCost         Float
  reportingUnit        String
  unitsPerPurchase     Float
  costPerReportingUnit Float
  glCodeOverride       String?
  productNote          String?
  isActive             Boolean   @default(true)
  isArchived           Boolean   @default(false)
  deletedAt            DateTime?
  lastEditedByUserId   String?
  kind                 String    @default("PURCHASED") // PURCHASED | PREPARED
  // PREPARED only: the countable sub-recipe this ingredient is produced from.
  preparedFromRecipeId String?   @unique
  // Count-by-weighing container weights, stored in oz (dry). tare = empty
  // container, full = full container (full only needed for volume/count items).
  tareWeightOz         Float?
  fullWeightOz         Float?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization               @relation(fields: [organizationId], references: [id])
  category           IngredientCategory?        @relation(fields: [categoryId], references: [id])
  preparedFromRecipe Recipe?                    @relation("PreparedIngredient", fields: [preparedFromRecipeId], references: [id])
  vendorIngredients  VendorIngredient[]
  purchaseOrderLines PurchaseOrderLine[]
  costLogs           IngredientCostLog[]
  storageMappings    IngredientStorageMapping[]
  countLines         InventoryCountLine[]
  recipeLines        RecipeLine[]
  adjustments        InventoryAdjustment[]
  storePars          StoreIngredientPar[]
  linkedMessages     TeamMessage[]
}

model IngredientCostLog {
  id                   String   @id @default(cuid())
  ingredientId         String
  costPerReportingUnit Float
  source               String // PO_RECEIPT | MANUAL | IMPORT
  sourceRef            String?
  createdAt            DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model IngredientDuplicateDismissal {
  id             String   @id @default(cuid())
  organizationId String
  ingredientAId  String
  ingredientBId  String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, ingredientAId, ingredientBId])
}

model InventoryCount {
  id                  String    @id @default(cuid())
  organizationId      String
  storeId             String
  name                String?
  notes               String?
  isPartial           Boolean   @default(false)
  startedAt           DateTime  @default(now())
  finalizedAt         DateTime?
  completedByUserIds  String[]
  sittingInventoryVal Float?
  status              String    @default("Draft") // Draft | Finalized

  organization Organization               @relation(fields: [organizationId], references: [id])
  store        Store                      @relation(fields: [storeId], references: [id])
  lines        InventoryCountLine[]
  corrections  InventoryCountCorrection[]
}

// One line per (storage area, ingredient) assignment, snapshotted when the draft
// is created — name/unit/cost frozen at count start so later price changes never
// rewrite a finalized count. quantityCounted null = not yet counted (distinct
// from an explicit 0 on the shelf).
model InventoryCountLine {
  id                   String    @id @default(cuid())
  inventoryCountId     String
  storageAreaId        String?
  ingredientId         String
  ingredientName       String
  reportingUnit        String
  quantityCounted      Float?
  costPerReportingUnit Float
  lineValue            Float?
  usageVariance        Float?
  sortOrder            Int       @default(0)
  countedAt            DateTime?

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  storageArea    StorageArea?   @relation(fields: [storageAreaId], references: [id])
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id])
}

// Audit trail for post-finalize corrections — one row per changed field. The
// count total is recomputed but the original entry stays explainable.
model InventoryCountCorrection {
  id        String   @id @default(cuid())
  countId   String
  lineId    String
  field     String // quantityCounted | costPerReportingUnit
  oldValue  Float?
  newValue  Float?
  note      String?
  userId    String
  createdAt DateTime @default(now())

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
}

// ─── PHASE I-5: SALES CACHES (Square Orders → local aggregates) ──────────────
// Populated by the sales sync (SearchOrders, COMPLETED, closed_at). Dates and
// hours are bucketed in the STORE's timezone. Sync is idempotent per day: a
// re-sync replaces the covered days wholesale.

model SalesPeriodCache {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  date           DateTime @db.Date
  grossSales     Float    @default(0) // total collected: incl. tax + tips, after discounts
  netSales       Float    @default(0) // sales metric: gross − tax − tips (excludes tax & tips)
  unconfirmedNet Float    @default(0) // portion of netSales from paid-but-OPEN orders (not yet confirmed in the POS)
  taxTotal       Float    @default(0)
  tipTotal       Float    @default(0)
  discountTotal  Float    @default(0)
  orderCount     Int      @default(0)
  syncedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([organizationId, date])
}

// Per Square variation per day — feeds the Item Sales report now and
// theoretical usage / variance in I-6.
model SalesLineCache {
  id                String   @id @default(cuid())
  organizationId    String
  storeId           String
  date              DateTime @db.Date
  squareVariationId String
  quantitySold      Float    @default(0)
  grossSales        Float    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, squareVariationId])
  @@index([storeId, date])
}

// Hourly pace — feeds the Dashboard (D-1) intraday chart.
model SalesHourlyCache {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  date           DateTime @db.Date
  hour           Int // 0–23, store-local
  netSales       Float    @default(0)
  orderCount     Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, hour])
  @@index([storeId, date])
}

// ─── PHASE D-1: DASHBOARD ─────────────────────────────────────────────────────

// Monthly sales goal per store (month = first-of-month UTC date). Managers and
// admins set it; the Dashboard's Monthly Goal card reads it.
model StoreMonthlyGoal {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  month          DateTime @db.Date
  goalAmount     Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, month])
}

// ─── PHASE I-6: RECIPES, ADJUSTMENTS, TRANSFERS, LOSS & PREP ─────────────────
// Recipes NEVER write to Square — a recipe attaches to a variation via
// salesItemId only; all Square fields on SalesItem stay read-only.

// salesItemId null = sub-recipe/batch (e.g. "Cup Kit - 32oz") usable as a line
// inside other recipes. servingSize* pre-fills the amount field when this
// recipe is added as a line in the editor. Costs are computed at read time
// (src/lib/recipe-cost.ts) — never stored on the recipe.
model Recipe {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  salesItemId     String?  @unique
  yieldQty        Float    @default(1)
  yieldUnit       String   @default("serving")
  servingSizeQty  Float?
  servingSizeUnit String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id])
  salesItem          SalesItem?   @relation(fields: [salesItemId], references: [id])
  lines              RecipeLine[]
  usedIn             RecipeLine[] @relation("SubRecipeLine")
  preparedIngredient Ingredient?  @relation("PreparedIngredient")

  @@index([organizationId])
}

// Exactly one of ingredientId/subRecipeId is set (enforced in Zod). unit is a
// usage unit convertible to the ingredient's reporting-unit dimension.
model RecipeLine {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String?
  subRecipeId  String?
  amount       Float
  unit         String
  sortOrder    Int     @default(0)

  recipe     Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])
  subRecipe  Recipe?     @relation("SubRecipeLine", fields: [subRecipeId], references: [id])

  @@index([recipeId])
  @@index([subRecipeId])
}

// Header for multi-line stock movements: one transfer / loss entry / prep batch
// = one group + its InventoryAdjustment rows. TRANSFER: fromStoreId (+ toStoreId,
// or destinationLabel for non-tracked destinations like "Kitchen"). PREP:
// recipeId + batchMultiplier enable the "re-record" shortcut. occurredAt is
// backdatable so rows land in the right inventory period.
model AdjustmentGroup {
  id               String   @id @default(cuid())
  organizationId   String
  type             String // TRANSFER | LOSS | PREP
  fromStoreId      String?
  toStoreId        String?
  destinationLabel String?
  recipeId         String?
  batchMultiplier  Float?
  occurredAt       DateTime
  note             String?
  createdByUserId  String
  createdAt        DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id])
  fromStore    Store?                @relation("AdjustmentGroupFromStore", fields: [fromStoreId], references: [id])
  toStore      Store?                @relation("AdjustmentGroupToStore", fields: [toStoreId], references: [id])
  adjustments  InventoryAdjustment[]

  @@index([organizationId, occurredAt])
}

// quantity is the SIGNED stock effect in reporting units: negative reduces
// on-hand (WASTE, COMP, TRANSFER_OUT, PREP_CONSUME), positive increases it
// (TRANSFER_IN, PREP_PRODUCE), CORRECTION is either. value = quantity × cost.
// APIs accept positive user input and apply the sign. occurredAt (backdatable)
// buckets the row into an inventory period; createdAt is the audit timestamp.
model InventoryAdjustment {
  id                   String   @id @default(cuid())
  organizationId       String
  storeId              String
  ingredientId         String
  ingredientName       String
  type                 String // WASTE | TRANSFER_IN | TRANSFER_OUT | COMP | CORRECTION | PREP_CONSUME | PREP_PRODUCE
  quantity             Float
  costPerReportingUnit Float
  value                Float
  reason               String?
  lossReasonId         String?
  groupId              String?
  occurredAt           DateTime @default(now())
  createdByUserId      String
  createdAt            DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient       @relation(fields: [ingredientId], references: [id])
  lossReason   LossReason?      @relation(fields: [lossReasonId], references: [id])
  group        AdjustmentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([storeId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([groupId])
}

// Seeded per org: Spoilage, Breakage, Comp, Theft/Unknown (isDefault). Orgs add
// custom reasons; referenced rows keep reasons from being deleted (no cascade).
model LossReason {
  id             String  @id @default(cuid())
  organizationId String
  label          String
  isDefault      Boolean @default(false)
  sortOrder      Int     @default(0)

  organization Organization          @relation(fields: [organizationId], references: [id])
  adjustments  InventoryAdjustment[]

  @@unique([organizationId, label])
}

// Manual sold-quantity correction on the Variance report ONLY — Square sales
// data stays untouched. periodKey = "<beginCountId>_<endCountId>". One row per
// (store, salesItem, period); the API upserts.
model VarianceAdjustment {
  id              String   @id @default(cuid())
  organizationId  String
  storeId         String
  salesItemId     String
  periodKey       String
  qtyDelta        Float
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  salesItem    SalesItem    @relation(fields: [salesItemId], references: [id])

  @@unique([storeId, salesItemId, periodKey])
}

// ─── PHASE I-7: PARS, REORDER POINTS & SMART ORDERING ────────────────────────

// Par level and reorder point per ingredient per store, in the ingredient's
// REPORTING unit (the UI shows the purchase-unit equivalent via units.ts).
// A low-stock alert fires when expected on-hand < reorderPoint (parLevel when
// no reorder point is set — reorder point wins when both exist); Smart Cart's
// fill-to-par restocks to parLevel. Distinct from the legacy
// ItemMetadata.parLevel Square-catalog stub, which stays untouched.
model StoreIngredientPar {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  ingredientId   String
  parLevel       Float?
  reorderPoint   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([storeId, ingredientId])
  @@index([organizationId])
}

// ─── PHASE 2: NUTRITION MODULE ────────────────────────────────────────────────

model MenuItem {
  id                 String   @id @default(cuid())
  organizationId     String
  squareCatalogObjId String?
  name               String
  description        String?
  category           String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id])
  nutrition    MenuItemNutrition?
  allergens    MenuItemAllergen[]
}

model MenuItemNutrition {
  id            String  @id @default(cuid())
  menuItemId    String  @unique
  servingSize   String?
  calories      Int?
  totalFatG     Float?
  saturatedFatG Float?
  transFatG     Float?
  cholesterolMg Float?
  sodiumMg      Float?
  totalCarbG    Float?
  dietaryFiberG Float?
  totalSugarsG  Float?
  addedSugarsG  Float?
  proteinG      Float?
  vitaminDMcg   Float?
  calciumMg     Float?
  ironMg        Float?
  potassiumMg   Float?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model MenuItemAllergen {
  id         String @id @default(cuid())
  menuItemId String
  allergen   String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, allergen])
}

// ─── PHASE F: SALES GOALS & FORECASTING ──────────────────────────────────────
// One GoalPlan per store per year. DailyGoal rows are MATERIALIZED (not
// computed on read) so the calendar is one indexed query and manual overrides
// are first-class rows. basisAmount is stored per day so the increase % can be
// re-applied at any time without re-querying Square. Actuals come from
// SalesPeriodCache (I-5) — Square is never read on a dashboard/calendar path.

enum GoalBasisType {
  SQUARE_LAST_YEAR
  IMPORT
  MANUAL
}

model GoalPlan {
  id             String        @id @default(cuid())
  organizationId String
  storeId        String
  year           Int
  basisType      GoalBasisType
  basisTotal     Float         @default(0)
  increasePct    Float         @default(0)
  goalTotal      Float         @default(0) // derived, denormalized
  importFileUrl  String? // Vercel Blob URL when basisType = IMPORT
  updatedById    String // Clerk user id of last editor
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dailyGoals   DailyGoal[]

  @@unique([storeId, year])
  @@index([organizationId, year])
}

model DailyGoal {
  id          String   @id @default(cuid())
  planId      String
  storeId     String
  date        DateTime @db.Date
  basisAmount Float    @default(0) // LY same-weekday sales or imported value
  goalAmount  Float    @default(0)
  isOverride  Boolean  @default(false) // manually edited — survives % recalcs

  plan  GoalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  store Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([planId])
}

// ─── PHASE I-14: TEAM MESSAGING (Phase 1) ────────────────────────────────────
// Every post is structured data: `type` drives filtering and later automation
// (a shortage with linkedIngredientId can flag inventory with no schema change).
// The postedTo*/source* trio powers checklist handoff notes — NULL on regular
// feed posts. Soft delete + editedAt keep an audit trail for staffing and
// customer-complaint documentation.

model TeamMessage {
  id                   String    @id @default(cuid())
  organizationId       String
  storeId              String
  // authorUser = the logged-in account; authorStaff = the optional "who is
  // posting" pick from the store roster (same split as TaskLog completedBy*).
  authorUserId         String?
  authorStaffId        String?
  type                 String    @default("general") // shift_note | shortage | equipment | customer_feedback | staffing | shoutout | general
  shiftPhase           String? // opening | mid | closing — set when type = shift_note
  body                 String
  linkedIngredientId   String? // shortage → inventory tie-in (module-gated in UI)
  // Checklist handoff: which template's instance this note renders on, for
  // which day, and which checklist the author was working when they posted.
  postedToTemplateId   String?
  postedForDate        DateTime? @db.Date
  sourceChecklistId    String?
  status               String    @default("open") // open | resolved | archived — free ticket system for shortage/equipment
  resolvedByUserId     String?
  resolvedAt           DateTime?
  // Handoff lifecycle: explicit Acknowledge (not viewing) clears a note from
  // checklist banners and the dashboard; expiresAt bounds how long an
  // unacknowledged note keeps surfacing (org-configurable, from postedForDate).
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  editedAt             DateTime?
  deletedAt            DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id])
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  authorUser         User?               @relation("TeamMessageAuthor", fields: [authorUserId], references: [id])
  authorStaff        StaffMember?        @relation(fields: [authorStaffId], references: [id])
  resolvedByUser     User?               @relation("TeamMessageResolver", fields: [resolvedByUserId], references: [id])
  acknowledgedByUser User?               @relation("TeamMessageAcknowledger", fields: [acknowledgedByUserId], references: [id])
  linkedIngredient   Ingredient?         @relation(fields: [linkedIngredientId], references: [id])
  postedToTemplate   Template?           @relation("HandoffTarget", fields: [postedToTemplateId], references: [id])
  sourceChecklist    Checklist?          @relation("HandoffSource", fields: [sourceChecklistId], references: [id])
  attachments        MessageAttachment[]
  reactions          MessageReaction[]
  reads              MessageRead[]

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, postedToTemplateId, postedForDate])
  @@index([organizationId, createdAt(sort: Desc)])
}

// Attached to EITHER a team message or a corporate update (exactly one —
// enforced in the routes; both FKs cascade). kind=youtube stores the canonical
// watch URL (no blob); image/document store the Vercel Blob URL.
model MessageAttachment {
  id                String   @id @default(cuid())
  messageId         String?
  corporateUpdateId String?
  kind              String // image | document | youtube
  url               String
  filename          String?
  contentType       String?
  sizeBytes         Int?
  createdAt         DateTime @default(now())

  message         TeamMessage?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  corporateUpdate CorporateUpdate? @relation(fields: [corporateUpdateId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([corporateUpdateId])
}

// One reaction per emoji per user, enforced by the unique. Emoji set is
// allow-listed in the route (👍 🎉 ❤️ 😂 👀 🙏).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

// Powers unread badges now; Phase 2 corporate-update acknowledgments reuse the
// same pattern.
model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// Minimal Phase 1 version — powers the dashboard CORPORATE UPDATE box.
// Acknowledgments and Twilio notifications are Phase 2+.
model CorporateUpdate {
  id             String    @id @default(cuid())
  organizationId String
  authorUserId   String // admin only, enforced in routes
  title          String
  body           String
  storeIds       String[]  @default([]) // empty = visible to all stores
  pinnedUntil    DateTime? // stays in the dashboard box until this date
  publishedAt    DateTime? // NULL = draft
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  authorUser   User                @relation(fields: [authorUserId], references: [id])
  attachments  MessageAttachment[]

  @@index([organizationId, publishedAt(sort: Desc)])
}

// ─── HR, TRAINING & COMPLIANCE MODULE ────────────────────────────────────────
// Forward-compat schema (HR-0): models exist; no app code reads them yet beyond
// the availability gate + activeModules "hr" toggle. Runs PARALLEL to Square
// Payroll — Froot never stores SSN / W-4 / I-9 / bank data. Froot owns the
// internal-document layer: acknowledgments, signed records, fillable
// agreements, manager notes, and trackable training.

enum HrCheckpointType {
  Field
  Initial
  Signature
  Acknowledgment
}

enum HrAckMethod {
  Field
  Initial
  Signature
  ReadReceipt
  Attested
}

enum HrAuthMethod {
  ClerkSession
  Kiosk
  ManagerAttested
}

// HR-11b: what an anchor's captured value renders as when stamped inline.
enum HrAnchorMarkType {
  Initial // signer initials, e.g. [TPT]
  PrintedName // printed full name
  DateStamp // date (or date+time per Organization.hrDateStampFormat)
  Store // signer's store assignment
  SignatureStamp // stylized name + "Signed electronically" + timestamp + record ref
}

// HR-11b: where the mark sits relative to the detected anchor token/line.
enum HrAnchorPlacement {
  Right
  Above
  Below
}

// An internal document (handbook, pay agreement, policy...). The FILE lives on
// versions; checkpoints/fields describe what a staff member must sign or fill.
// linkedFormId pairs Check-Out ↔ Check-In style forms.
model HrDocument {
  id                     String   @id @default(cuid())
  organizationId         String
  kind                   String // Acknowledgment | FillableForm | Reference
  title                  String
  category               String // Handbook | PayAgreement | Policy | HRManagement | Other
  appliesTo              String   @default("all") // all | selected (store assignments below)
  requiresAcknowledgment Boolean  @default(false)
  isActive               Boolean  @default(true)
  linkedFormId           String? // Check-Out ↔ Check-In form pairing
  bodyText               String? // FillableForm: the agreement's fixed language, rendered above the fields
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization     Organization                @relation(fields: [organizationId], references: [id])
  versions         HrDocumentVersion[]
  checkpoints      HrDocumentCheckpoint[]
  formFields       FormField[]
  storeAssignments HrDocumentStoreAssignment[]

  @@index([organizationId])
}

model HrDocumentStoreAssignment {
  id           String @id @default(cuid())
  hrDocumentId String
  storeId      String

  hrDocument HrDocument @relation(fields: [hrDocumentId], references: [id], onDelete: Cascade)
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([hrDocumentId, storeId])
}

// Immutable file snapshot per upload. fileHash (sha256 of the exact bytes) is
// the version pin acknowledgments reference — never overwrite a version's file.
//
// FillableForm versions (HR-5) have no uploaded file: the definition (bodyText
// + fields) is snapshotted in definitionSnapshot, fileHash holds the sha256 of
// the canonical definition JSON, and the file columns carry sentinels
// (fileUrl "", contentType application/x-froot-form-definition, sizeBytes =
// JSON byte length). Same pin semantics, no nullability change for HR-4.
model HrDocumentVersion {
  id                 String   @id @default(cuid())
  hrDocumentId       String
  versionNumber      Int
  fileUrl            String
  fileName           String
  contentType        String
  sizeBytes          Int
  fileHash           String // sha256 (file bytes, or canonical form-definition JSON)
  definitionSnapshot Json? // FillableForm: frozen { bodyText, fields } this version pins
  isCurrent          Boolean  @default(true)
  uploadedByUserId   String
  createdAt          DateTime @default(now())

  hrDocument      HrDocument                 @relation(fields: [hrDocumentId], references: [id], onDelete: Cascade)
  acknowledgments HrDocumentAcknowledgment[]
  formSubmissions FormSubmission[]
  signedRecords   HrSignedRecord[]
  anchors         DocumentAnchor[]

  @@unique([hrDocumentId, versionNumber])
}

// Confirmed by the HR-0a spike against the real 2026 Employee Handbook
// (35 checkpoints: 3 Field, 27 Initial, 1 Signature, 4 Acknowledgment).
model HrDocumentCheckpoint {
  id              String           @id @default(cuid())
  hrDocumentId    String
  name            String // e.g. "Page 7 initial", "Final Employee Handbook acknowledgment"
  type            HrCheckpointType
  orderIndex      Int
  pageRef         Int? // page anchor -> enables in-page stamping later
  attestationText String? // present for Acknowledgment; the "I have read and understand..." text
  required        Boolean          @default(true)

  hrDocument      HrDocument                 @relation(fields: [hrDocumentId], references: [id], onDelete: Cascade)
  acknowledgments HrDocumentAcknowledgment[]
}

// HR-11b: a field anchor detected in a specific document VERSION's text layer.
// Bound to the version (coordinates are meaningless across files); checkpoints
// stay document-level and are generated FROM confirmed anchors. Detection is
// metadata, not a legal record — hence onDelete: Cascade (unlike acks/signed
// records, which block version deletion). Re-detection replaces the version's
// UNCONFIRMED set only; confirmed anchors and any acked checkpoints are never
// disturbed (see DECISIONS: G1 integrity rule). generatedCheckpointId is a soft
// pointer (no FK) so checkpoint removal never cascades into anchor integrity.
model DocumentAnchor {
  id                    String            @id @default(cuid())
  hrDocumentVersionId   String
  page                  Int // 1-based
  x                     Float // PDF user space, MediaBox-relative, bottom-left origin
  y                     Float
  width                 Float? // detected token width, for placement math
  pageRotation          Int               @default(0) // page /Rotate at detection (D2)
  anchorText            String // matched anchor token, verbatim
  markType              HrAnchorMarkType
  placement             HrAnchorPlacement @default(Right)
  confirmed             Boolean           @default(false) // proposal -> admin-confirmed
  generatedCheckpointId String? // soft link to the checkpoint this anchor created
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  version HrDocumentVersion @relation(fields: [hrDocumentVersionId], references: [id], onDelete: Cascade)

  @@index([hrDocumentVersionId])
}

// The defensible signed record. staffMemberId/userId are intentionally plain
// strings (no FK): the snapshot columns below are the record of who signed
// what, frozen at signing time — they must survive any later edit or delete.
model HrDocumentAcknowledgment {
  id                    String       @id @default(cuid())
  checkpointId          String
  hrDocumentVersionId   String
  staffMemberId         String?
  userId                String?
  // --- snapshots frozen at signing time (survive later edits) ---
  checkpointName        String
  checkpointType        String
  documentTitle         String
  documentVersionNumber Int
  documentFileHash      String // sha256 of the exact bytes signed (version pin)
  staffName             String
  storeName             String?
  attestationText       String?
  // --- what was captured ---
  method                HrAckMethod
  typedName             String?
  signatureImageUrl     String? // for drawn signatures (nullable)
  fieldValue            String? // for Field checkpoints
  // --- audit / ESIGN evidence ---
  signedAt              DateTime     @default(now())
  ipAddress             String?
  userAgent             String?
  authMethod            HrAuthMethod
  consentGiven          Boolean
  consentText           String?
  consentVersion        String?
  // HR-15 Policy B: the staff member's signingCycle at signing time. A rehire
  // (cycle bump) re-acknowledges as new rows; prior-cycle rows are untouched.
  signingCycle          Int          @default(1)

  checkpoint HrDocumentCheckpoint @relation(fields: [checkpointId], references: [id])
  version    HrDocumentVersion    @relation(fields: [hrDocumentVersionId], references: [id])

  @@unique([checkpointId, hrDocumentVersionId, staffMemberId, signingCycle])
}

// HR-4: the executed-document artifact — one per (version, staff), created
// when every required checkpoint for that version is complete. Append-only:
// no update/delete path exists. FKs deliberately have no cascade, so a signed
// record blocks deletion of the version/staff it pins.
model HrSignedRecord {
  id                  String   @id @default(cuid())
  hrDocumentVersionId String
  staffMemberId       String
  completedAt         DateTime // when the last required checkpoint was signed
  signedPdfPathname   String // pathname in the PRIVATE froot-hr Blob store
  signedPdfHash       String // sha256 of the generated signed PDF bytes
  generatedAt         DateTime @default(now())
  // HR-15 Policy B: the tenure this record belongs to — a rehire earns a new
  // record for the same version under the new cycle; old records stand.
  signingCycle        Int      @default(1)

  version     HrDocumentVersion @relation(fields: [hrDocumentVersionId], references: [id])
  staffMember StaffMember       @relation(fields: [staffMemberId], references: [id])

  @@unique([hrDocumentVersionId, staffMemberId, signingCycle])
  @@index([staffMemberId])
}

// Field definitions for kind=FillableForm documents. These rows are the
// EDITABLE current definition; the signed copy lives in each version's
// definitionSnapshot, so submissions never depend on these rows.
model FormField {
  id           String  @id @default(cuid())
  hrDocumentId String
  label        String
  fieldType    String // Text | Date | Email | Phone | Number | Select (FORM_FIELD_TYPES)
  required     Boolean @default(true)
  orderIndex   Int     @default(0)
  options      Json? // Select: array of choice strings

  hrDocument HrDocument @relation(fields: [hrDocumentId], references: [id], onDelete: Cascade)
}

// A staff member's execution of a fillable form (HR-5). Pinned to the document
// VERSION they filled; no cascade — submissions are records and outlive form
// edits. Re-execution is first-class: NO unique on (version, staff) — pay
// agreements and key check-outs recur, so a staff member accumulates
// submissions over time. Append-only: after create, the only writes ever
// allowed are the supervisor countersign block (once, while
// PendingSupervisor) and the three write-once signedPdf* columns. The
// executed PDF lives HERE, not on HrSignedRecord (that stays acknowledgment-
// only, keyed one-per-version-per-staff).
model FormSubmission {
  id                     String    @id @default(cuid())
  hrDocumentVersionId    String
  staffMemberId          String
  values                 Json
  employeeSignatureUrl   String? // unused: HR-4/5 capture is typed-name (kept for drawn signatures later)
  supervisorSignatureUrl String?
  signedAt               DateTime  @default(now())
  ipAddress              String? // employee-side audit (supervisor block below)
  userAgent              String?
  // --- dual-signer execution (HR-5) ---
  status                 String    @default("PendingSupervisor") // PendingSupervisor | Completed
  supervisorUserId       String?
  employeeTypedName      String?
  supervisorTypedName    String?
  employeeSignedAt       DateTime?
  supervisorSignedAt     DateTime?
  supervisorIpAddress    String?
  supervisorUserAgent    String?
  // --- snapshots frozen at signing time (survive later edits) ---
  formTitle              String?
  formVersionNumber      Int?
  staffName              String?
  storeName              String?
  definitionHash         String? // sha256 of the definition JSON signed (version pin)
  consentText            String?
  consentVersion         String?
  // --- executed artifact in the PRIVATE froot-hr store; write-once ---
  signedPdfPathname      String?
  signedPdfHash          String? // sha256 of the generated PDF bytes
  generatedAt            DateTime?

  version     HrDocumentVersion @relation(fields: [hrDocumentVersionId], references: [id])
  staffMember StaffMember       @relation(fields: [staffMemberId], references: [id])

  @@index([staffMemberId])
  @@index([hrDocumentVersionId])
}

// Private manager log per staff member (conversations, attendance, coaching).
model ManagerNote {
  id             String   @id @default(cuid())
  organizationId String
  staffMemberId  String
  authorUserId   String
  category       String // Conversation | Attendance | Coaching | Feedback | General
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  staffMember  StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, createdAt(sort: Desc)])
  @@index([organizationId])
}

// HR-7.6: a manager-uploaded file attached to ONE staff member — a scanned or
// photographed completed paper document (signed pay agreement, write-up, etc.)
// that lives outside the org-template system. The file is in the PRIVATE
// froot-hr Blob store. visibleToStaff is the manager's per-document switch:
// true → the owning staff member can view/download it in /my/documents; false
// → managers/admins only. Distinct from the auto-generated signed-record/cert
// tier (rule 5) — this class is manager-controlled visibility by design. No
// cascade from the staff member: uploads are retained records that outlive the
// employee (they also block hard-delete of the member). uploadedByUserId is a
// plain id (no FK) so the upload survives the uploader's deletion.
model StaffDocument {
  id               String   @id @default(cuid())
  organizationId   String
  staffMemberId    String
  uploadedByUserId String
  title            String
  category         String? // free label: Pay | Disciplinary | Onboarding | General...
  fileName         String
  fileUrl          String // full private blob URL
  filePathname     String // store-relative pathname for presigning
  contentType      String
  sizeBytes        Int
  fileHash         String // sha256 of the stored bytes
  visibleToStaff   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  staffMember  StaffMember  @relation(fields: [staffMemberId], references: [id])

  @@index([staffMemberId, createdAt(sort: Desc)])
  @@index([organizationId])
}

model TrainingModule {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  subject        String?
  description    String?
  appliesTo      String   @default("all") // all | selected (store assignments below)
  isActive       Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization                    @relation(fields: [organizationId], references: [id])
  lessons          TrainingLesson[]
  quizzes          TrainingQuiz[]
  assignments      TrainingAssignment[]
  storeAssignments TrainingModuleStoreAssignment[]

  @@index([organizationId])
}

model TrainingModuleStoreAssignment {
  id               String @id @default(cuid())
  trainingModuleId String
  storeId          String

  trainingModule TrainingModule @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([trainingModuleId, storeId])
}

model TrainingLesson {
  id               String  @id @default(cuid())
  trainingModuleId String
  title            String
  info             String?
  videoUrl         String?
  orderIndex       Int     @default(0)

  trainingModule TrainingModule           @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)
  resources      TrainingResource[]
  progress       TrainingLessonProgress[]
}

// Downloadable attachments per lesson (UI caps at 4/lesson).
model TrainingResource {
  id               String @id @default(cuid())
  trainingLessonId String
  label            String
  fileUrl          String
  contentType      String
  sizeBytes        Int
  orderIndex       Int    @default(0)

  trainingLesson TrainingLesson @relation(fields: [trainingLessonId], references: [id], onDelete: Cascade)
}

// Quiz per module; questions stay Json until the quiz builder phase.
model TrainingQuiz {
  id               String @id @default(cuid())
  trainingModuleId String
  passThreshold    Int    @default(80)
  questions        Json

  trainingModule TrainingModule @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)
}

// One staff member's run through a module. No cascade from the module —
// completed/certified assignments are records.
model TrainingAssignment {
  id                String    @id @default(cuid())
  trainingModuleId  String
  staffMemberId     String
  assignedByUserId  String
  trainerUserId     String?
  dueDate           DateTime?
  status            String    @default("NotStarted") // NotStarted | InProgress | Completed
  hoursLogged       Float?
  certifiedAt       DateTime?
  // HR-7 certification (trainer co-sign): write-once pointer to the signed
  // certificate PDF in the PRIVATE froot-hr store, HR-5 pattern — each
  // executed thing owns its PDF. Downloads are ADMIN / in-scope MANAGER only.
  certPdfPathname   String?
  certPdfHash       String? // sha256 of the generated PDF bytes
  certifiedByUserId String? // trainer who co-signed (plain id, survives user deletion)
  trainerTypedName  String? // trainer's typed-name capture at co-sign
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trainingModule TrainingModule           @relation(fields: [trainingModuleId], references: [id])
  staffMember    StaffMember              @relation(fields: [staffMemberId], references: [id])
  lessonProgress TrainingLessonProgress[]
  quizAttempts   TrainingQuizAttempt[]

  @@index([staffMemberId])
  @@index([trainingModuleId])
}

model TrainingLessonProgress {
  id                   String        @id @default(cuid())
  trainingAssignmentId String
  trainingLessonId     String
  completedAt          DateTime      @default(now())
  completedByStaffId   String?
  // HR-7: how this completion was captured — ClerkSession (staff self-serve
  // at /my/training) or ManagerAttested (manager records it for login-less
  // staff; completedByUserId is the attesting manager). Null on pre-HR-7 rows.
  authMethod           HrAuthMethod?
  completedByUserId    String? // attesting manager (plain id, survives user deletion)

  trainingAssignment TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id], onDelete: Cascade)
  trainingLesson     TrainingLesson     @relation(fields: [trainingLessonId], references: [id], onDelete: Cascade)
  completedByStaff   StaffMember?       @relation(fields: [completedByStaffId], references: [id])

  @@unique([trainingAssignmentId, trainingLessonId])
}

// HR-7: one staff member's sitting of a module quiz. Append-only: after
// create, the only write ever allowed is the written-answer review block
// (once, while PendingReview). The questions and threshold are snapshotted at
// attempt time so later quiz edits never change what an attempt meant — same
// pin semantics as HR-4/5 signing snapshots. No cascade from the assignment:
// attempts are records.
model TrainingQuizAttempt {
  id                    String       @id @default(cuid())
  trainingAssignmentId  String
  questionsSnapshot     Json // quiz questions as graded, frozen at submit time
  passThresholdSnapshot Int
  answers               Json // { [questionId]: string | string[] }
  scorePct              Int? // null while PendingReview (written answers ungraded)
  status                String // Passed | Failed | PendingReview
  authMethod            HrAuthMethod
  attestedByUserId      String? // manager who captured a ManagerAttested attempt
  reviewedByUserId      String? // trainer who graded written answers
  reviewedAt            DateTime?
  ipAddress             String?
  userAgent             String?
  submittedAt           DateTime     @default(now())

  trainingAssignment TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id])

  @@index([trainingAssignmentId])
}

// ─── LABOR MODEL (Phase 0) ────────────────────────────────────────────────────
// Money is stored in DOLLARS as Decimal(10,2) to match the codebase's dollar
// convention (SalesPeriodCache, GoalPlan, etc.) while giving exact precision.
// Square imports (cents) convert at the boundary; the budget service computes
// internally in integer cents to keep rounding exact. See LABOR.md.

enum LaborPayType {
  HOURLY
  SALARIED
}

enum LaborDenominator {
  IN_STORE
  TOTAL_WITH_DELIVERY
}

enum SalesForecastSource {
  MANUAL
  LAST_YEAR
  TREND
}

/// L-3: how the weekly HOURLY hours are distributed across the days of the week.
/// FLOOR_FIRST (default) guarantees each open day enough hours to cover its
/// minimum floor before distributing the remainder by sales weight;
/// SALES_WEIGHTED is the pre-L-3 behavior (pure sales-weight split, slack days
/// may warn). Per-store via LaborSettings.dailySplitPolicy.
enum LaborDailySplitPolicy {
  FLOOR_FIRST
  SALES_WEIGHTED
}

/// L-3B cross-day rebalancing: a per-DATE override of a single day's allocated
/// hourly hours, letting ADMIN/MANAGER move hours between days WITHIN a week to
/// fix a day the floor-first split still leaves tight. Sits ON TOP of the
/// floor-first split (never corrupts the sales-weight defaults) and is scoped to
/// one date, so it never leaks to the same weekday in other weeks. weekStart
/// (Monday) is stored for week-scoped reads/clears. The route constrains the
/// week's overrides to the weekly hourly total.
model WeeklyDayHours {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  weekStart      DateTime @db.Date // Monday of the week (matches SalesForecast)
  date           DateTime @db.Date
  hoursOverride  Decimal  @db.Decimal(6, 2) // HOURLY person-hours for this day (not dollars)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([organizationId, storeId, weekStart])
}

/// Org-scoped labor positions (the rate legend): Store Manager, ASM, Lead
/// Supervisor, Supervisor, Team Member, District Manager, etc.
model LaborPosition {
  id                 String       @id @default(cuid())
  organizationId     String
  name               String
  payType            LaborPayType @default(HOURLY)
  defaultHourlyRate  Decimal      @db.Decimal(10, 2) // dollars; salaried positions also carry an implied hourly rate
  impliedWeeklyHours Int? // e.g. 40 for salaried; null for hourly
  isSupervisory      Boolean      @default(false) // Manager/ASM/Lead/Supervisor = true (for the Phase-2 coverage rule)
  sortOrder          Int          @default(0)
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

/// Org default settings (storeId null) with optional per-store override rows.
model LaborSettings {
  id                    String                @id @default(cuid())
  organizationId        String
  storeId               String? // null = org default
  laborTargetPct        Decimal               @default(20.00) @db.Decimal(5, 2)
  roundingIncrement     Decimal               @default(1000.00) @db.Decimal(10, 2) // dollars; default $1,000
  denominator           LaborDenominator      @default(TOTAL_WITH_DELIVERY) // DEPRECATED (Phase 2): total sales only
  plannedBlendedRate    Decimal?              @db.Decimal(10, 2) // optional manual blended rate (dollars); else computed
  // L-3: floor-first vs sales-weighted weekly→daily hourly-hours split.
  dailySplitPolicy      LaborDailySplitPolicy @default(FLOOR_FIRST)
  // Phase 3: the salaried GM's default on-floor window (minutes from local
  // midnight). null = derive open→14:00 from StoreHours. The GM counts as a
  // body + the supervisor during this window.
  gmOnFloorStartMinutes Int?
  gmOnFloorEndMinutes   Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storeId])
  @@index([organizationId])
}

/// Weekly projected sales input. weekStart is normalized to Monday on write so
/// week keys are stable. Reuses the SalesForecastSource seam for later
/// LAST_YEAR/TREND derivation (Phase 3); Phase 1 writes MANUAL only.
model SalesForecast {
  id                  String              @id @default(cuid())
  organizationId      String
  storeId             String
  weekStart           DateTime            @db.Date // Monday of the week
  projectedStoreSales Decimal             @db.Decimal(10, 2) // dollars
  projectedDelivery   Decimal             @default(0) @db.Decimal(10, 2) // dollars
  source              SalesForecastSource @default(MANUAL)
  createdById         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekStart])
  @@index([organizationId, storeId])
}

// ─── LABOR MODEL (Phase 2) ────────────────────────────────────────────────────
// Total-sales only from Phase 2 on: LaborSettings.denominator and
// SalesForecast.projectedDelivery are DEPRECATED (retained, never dropped) —
// the budget basis is a single total (delivery is already in Square net sales).

/// Per-store day-of-week weighting for the weekly→daily hourly-hours split.
/// Weights are basis points (sum ≈ 10000) so the split is exact; auto-seeded
/// from trailing sales and flips isOverride when hand-edited. Salaried hours are
/// a weekly constant and are NOT split per day.
model LaborDaySplit {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  weekday        Int // 0 = Monday … 6 = Sunday (matches mondayOfWeekStr)
  weightBps      Int // basis points of the week (0–10000)
  isOverride     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday])
  @@index([organizationId, storeId])
}

/// Shift blocks / dayparts with minimum-staffing rules. Org default (storeId
/// null) with optional per-store overrides — same pattern as LaborSettings.
model LaborDaypart {
  id                 String   @id @default(cuid())
  organizationId     String
  storeId            String? // null = org default
  name               String // "Opening", "Mid", "Close"
  startLocalMinutes  Int // minutes from local midnight (480 = 8:00a)
  endLocalMinutes    Int // exclusive
  minHeadcount       Int      @default(1)
  requiresSupervisor Boolean  @default(false)
  sortOrder          Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Date-specific labor adjustment (weather, holiday, event). Scales that day's
/// HOURLY hours by adjustmentPct; salaried is untouched. Keyed by exact date,
/// not weekday, because conditions are one-off.
model LaborDayAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  date           DateTime @db.Date
  adjustmentPct  Decimal  @db.Decimal(5, 2) // e.g. -20.00 = staff 20% below
  reason         String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([organizationId, storeId])
}
